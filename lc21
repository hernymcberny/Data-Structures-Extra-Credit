/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    ListNode* mergeTwoLists(ListNode* list1, ListNode* list2) {
        if (!list1) { // creating base cases so if the other list is empty judt return this one
            return list2;
        }
        if (!list2) { // same as above
             return list1;
        }

        if (list1->val < list2->val) { // compare current nodes
            list1->next = mergeTwoLists(list1->next, list2); // if list1 is smaller make current value the head and merge the rest in based on whats bigger
            return list1; // returns head  
        }

        else {
            list2->next = mergeTwoLists(list2->next, list1); // if list2 is smaller make it head
            return list2; // return list2 head
        }
    }
};
